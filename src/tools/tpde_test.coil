;;; tpde-test: the TIR test driver, with the command line of TPDE's `tpde_test`
;;; so the same `.tir` tests run against both.
(module tpde.tools.tpde-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.args" :as args)
(import "coil.fs" :as fs)
(import "coil.io" :as io)
(import "coil.slice" :use [subslice])
(import "tpde.tir.ir" :as tir :use [Tir])
(import "tpde.tir.adaptor" :use [TirAdaptor])
(import "tpde.analyzer" :as analyzer :use [Analyzer])
(import "tpde.tir.cg" :as tircg)
(import "tpde.asm" :as asm :use [Asm])
(import "tpde.macho" :as macho)
(import "tpde.elf" :as elf)
(import "tpde.core" :as core)
(import "tpde.buf" :as buf :use [Buf])

(const RUN-IR 0)

(const RUN-ANALYZER 1)

(const RUN-FULL 2)

(defstruct Options
  [(print-ir bool)
   (print-rpo bool)
   (print-layout bool)
   (print-loops bool)
   (print-liveness bool)
   (no-fixed bool)
   (run-until i64)
   (arch (slice u8))
   (out (slice u8))
   (path (slice u8))
   (macho bool)])

(defn starts-with? [(s (slice u8)) (prefix (slice u8))] (-> bool)
  (and (>= (len s) (len prefix)) (= (subslice s 0 (len prefix)) prefix)))

(defn after [(s (slice u8)) (prefix (slice u8))] (-> (slice u8))
  (subslice s (len prefix) (len s)))

(defn parse-options [] (-> (Result Options (slice u8)))
  (let [(mut o)
          (Options
            :print-ir false
            :print-rpo false
            :print-layout false
            :print-loops false
            :print-liveness false
            :no-fixed false
            :run-until RUN-FULL
            :arch "x64"
            :out ""
            :path ""
            :macho false)
        (mut i) 1
        n (args/count)]
    (block :parse
      (while (< i n)
        (let [a (args/nth i)]
          (cond (= a "--print-ir") (set! (.print-ir o) true)
                (= a "--print-rpo") (set! (.print-rpo o) true)
                (= a "--print-layout") (set! (.print-layout o) true)
                (= a "--print-loops") (set! (.print-loops o) true)
                (= a "--print-liveness") (set! (.print-liveness o) true)
                (= a "--no-fixed-assignments") (set! (.no-fixed o) true)
                (starts-with? a "--run-until=")
                  (let [v (after a "--run-until=")]
                    (cond (= v "ir") (set! (.run-until o) RUN-IR)
                          (= v "analyzer") (set! (.run-until o) RUN-ANALYZER)
                          (= v "full") (set! (.run-until o) RUN-FULL)
                          :else (return-from :parse (Err "invalid --run-until"))))
                (starts-with? a "--target=")
                  (set! (.arch o) (after a "--target="))
                (= a "--macho") (set! (.macho o) true)
                (starts-with? a "--arch=") (set! (.arch o) (after a "--arch="))
                (or (= a "-o") (= a "--obj-out"))
                  (do (set! i (+ i 1)) (set! (.out o) (args/nth i)))
                (starts-with? a "--obj-out=")
                  (set! (.out o) (after a "--obj-out="))
                (starts-with? a "-") (return-from :parse (Err a))
                :else (set! (.path o) a)))
        (set! i (+ i 1)))
      (Ok o))))

(defn read-input [(path (slice u8))] (-> (Option (slice u8)))
  (let [a (malloc-allocator)]
    (if (empty? path)
        (match (io/read-to-end a (io/stdin))
          (Ok [bytes] (Some (.bytes bytes)))
          (Err [_] (None)))
        (match (fs/read-file a path)
          (Ok [bytes] (Some bytes))
          (Err [_] (eprintln "Failed to open file '{}'" path) (None))))))

(defn analyze-func [(adp (ptr TirAdaptor))
                    (an (mut (Analyzer TirAdaptor)))
                    (f u32)
                    (o Options)] (-> void)
  (switch-func adp f)
  (analyzer/switch-func! (mut an) f)
  (when (.print-rpo o)
    (println "RPO for func {}" (func-link-name adp f))
    (analyzer/print-rpo (mut an))
    (println "End RPO"))
  (when (.print-layout o)
    (println "Block Layout for {}" (func-link-name adp f))
    (analyzer/print-block-layout (mut an))
    (println "End Block Layout"))
  (when (.print-loops o)
    (println "Loops for {}" (func-link-name adp f))
    (analyzer/print-loops (mut an))
    (println "End Loops"))
  (when (.print-liveness o)
    (println "Liveness for {}" (func-link-name adp f))
    (analyzer/print-liveness (mut an))
    (println "End Liveness")))

(defn run-analyzer [(ir (ptr Tir)) (o Options)] (-> i64)
  (let [(mut ad) (TirAdaptor::new ir)
        adp (cast (ptr TirAdaptor) (mut ad))
        (mut an) (Analyzer::new [TirAdaptor] adp)]
    (for fi (range 0 (cast i64 (func-count adp)))
      (let [f (func-at adp (cast u32 fi))]
        (when (not (func-extern? adp f))
          (analyze-func adp (mut an) f o))))
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (match (parse-options)
    (Err [bad] (eprintln "Error parsing arguments: {}" bad) 1)
    (Ok [o]
        (match (read-input (.path o))
          (None [] 1)
          (Some [text]
                (let [(mut ir) (Tir::new)
                      irp (cast (ptr Tir) (mut ir))]
                  (cond (not (tir/parse-ir! irp text))
                          (do (eprintln "Failed to parse IR") 1)
                        (.print-ir o) (do (tir/print-ir irp) 0)
                        (= (.run-until o) RUN-IR) 0
                        (= (.run-until o) RUN-ANALYZER) (run-analyzer irp o)
                        :else (run-codegen irp o))))))))

(defn run-codegen [(ir (ptr Tir)) (o Options)] (-> i64)
  (let [a64
          (or (= (.arch o) "a64") (= (.arch o) "aarch64") (= (.arch o) "arm64"))
        x64
          (or (= (.arch o) "x64") (= (.arch o) "x86_64") (= (.arch o) "x86-64"))]
    (if (not (or a64 x64))
        (do (eprintln "unknown target {}" (.arch o)) 1)
        (let [(mut a) (Asm::new)
              ap (cast (ptr Asm) (mut a))]
          (if (not (tircg/compile-module! ir
                                          ap
                                          (.no-fixed o)
                                          (if x64 core/ARCH-X64 core/ARCH-A64)))
              (do (eprintln "Failed to compile IR") 1)
              (let [(mut out) (Buf::new)
                    op (cast (ptr Buf) (mut out))]
                ; arm64: Mach-O; x86-64: ELF as TPDE, or Mach-O with --macho
                (cond a64 (macho/write-object! ap op)
                      (.macho o) (macho/write-object-x64! ap op)
                      :else (elf/write-object! ap op))
                (if (or (empty? (.out o)) (= (.out o) "-"))
                    (do
                      (io/write-all (io/stdout)
                                    (cast (ptr i8) (.data out))
                                    (.len out))
                      0)
                    (match (fs/write-file (malloc-allocator)
                                          (.out o)
                                          (buf/as-slice op))
                      (Ok [_] 0)
                      (Err [_] (eprintln "Failed to open output file") 1)))))))))
