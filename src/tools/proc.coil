;;; Strings, processes and files for the tpde tools (tpde-bench, tpde-check).
(module tpde.tools.proc)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.fs" :as fs)
(import "coil.str" :use [StrBuf])
(import "coil.slice" :use [subslice])
(import "coil.arraylist" :use [ArrayList])
(import "coil.subprocess" :as sp)
(import "coil.time" :as time)
(import "coil.cancellation" :as cancellation)
(import "coil.primitive" :as primitive)

(export cat2
        cat3
        ends-with?
        starts-with?
        space?
        words
        lines
        Ran
        now-us
        run-cmd
        run-in
        argv-of
        list1
        read-text
        write-text
        sort-strings!
        coil-files-in)

; ---- strings ----

(defn starts-with? [(s (slice u8)) (prefix (slice u8))] (-> bool)
  (and (>= (len s) (len prefix)) (= (subslice s 0 (len prefix)) prefix)))

(defn cat2 [(x (slice u8)) (y (slice u8))] (-> (slice u8))
  (let [(mut b) (StrBuf::new (malloc-allocator))]
    (push-str! (mut b) x)
    (push-str! (mut b) y)
    (finish! (mut b))))

(defn cat3 [(x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (cat2 (cat2 x y) z))

(defn ends-with? [(s (slice u8)) (suffix (slice u8))] (-> bool)
  (and (>= (len s) (len suffix))
       (= (subslice s (- (len s) (len suffix)) (len s)) suffix)))

(defn space? [(c u8)] (-> bool)
  (or (= c #\space) (= c #\tab) (= c (: 13 u8))))

;;; The whitespace-separated words of `line`.
(defn words [(line (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))
        n (len line)
        (mut i) 0]
    (while (< i n)
      (while (and (< i n) (space? (get line i))) (set! i (+ i 1)))
      (let [start i]
        (while (and (< i n) (not (space? (get line i)))) (set! i (+ i 1)))
        (when (> i start) (push! (mut out) (subslice line start i)))))
    out))

;;; The lines of `text`.
(defn lines [(text (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))
        n (len text)
        (mut start) 0]
    (for i (range 0 n)
      (when (= (get text i) #\newline)
        (push! (mut out) (subslice text start i))
        (set! start (+ i 1))))
    (when (< start n) (push! (mut out) (subslice text start n)))
    out))

; ---- processes ----

(defstruct Ran
  [(started bool)
   (code i64)  ; exit status, or 128 + signal
   (timed-out bool)
   (out (slice u8))
   (err (slice u8))
   (us i64)])  ; wall time in microseconds

(defn now-us [] (-> i64)
  (match (time/monotonic-now)
    (Ok [t] (+ (* (.sec t) 1000000) (/ (.nsec t) 1000)))
    (Err [_] 0)))

;;; Run `prog` with `argv` (not including argv[0]) for at most `timeout-s`
;;; seconds, capturing its output.
(defn run-cmd [(prog (slice u8)) (argv (slice (slice u8))) (timeout-s i64)]
  (-> Ran)
  (run-in "" prog argv timeout-s))

;;; `run-cmd` in directory `cwd` ("" for this one).
(defn run-in [(cwd (slice u8))
              (prog (slice u8))
              (argv (slice (slice u8)))
              (timeout-s i64)] (-> Ran)
  (let [a (malloc-allocator)
        deadline
          (match (time/Duration::seconds timeout-s)
            (Ok [d]
                (match (time/Instant::from-now d)
                  (Ok [i] (Some i))
                  (Err [_] (None [time/Instant]))))
            (Err [_] (None [time/Instant])))
        grace
          (match (time/Duration::millis 200)
            (Ok [d] d)
            (Err [_] (time/Duration :sec 0 :nsec 0)))
        opts
          (sp/RunOptions::new prog
                              argv
                              cwd
                              268435456
                              268435456
                              deadline
                              (primitive/cast (ptr cancellation/Cancellation) 0)
                              grace)
        (mut res) (primitive/zeroed sp/RunResult)
        t0 (now-us)]
    (match (sp/run a (mut res) opts)
      (Ok [_]
          (Ran
            :started true
            :code
              (match (.status res)
                (sp/Exited [c] c)
                (sp/Signaled [s] (+ 128 s)))
            :timed-out (.timed-out res)
            :out (.stdout res)
            :err (.stderr res)
            :us (- (now-us) t0)))
      (Err [_]
           (Ran
             :started false
             :code -1
             :timed-out false
             :out ""
             :err ""
             :us 0)))))

(defn argv-of [(xs (ArrayList (slice u8)))] (-> (slice (slice u8)))
  (slice xs))

(defn list1 [(x (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut l) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (push! (mut l) x)
    l))

; ---- files ----

;;; The contents of `path`, or None.
(defn read-text [(path (slice u8))] (-> (Option (slice u8)))
  (match (fs/read-file (malloc-allocator) path)
    (Ok [bytes] (Some bytes))
    (Err [_] (None [(slice u8)]))))

(defn write-text [(path (slice u8)) (text (slice u8))] (-> bool)
  (match (fs/write-file (malloc-allocator) path text)
    (Ok [_] true)
    (Err [_] false)))

(defn sort-strings! [(xs (mut (ArrayList (slice u8))))] (-> void)
  (let [n (len xs)]
    (for i (range 1 n)
      (let [x (get xs i)
            (mut j) i]
        (while (and (> j 0) (> (get xs (- j 1)) x))
          (set! (mut xs) j (get xs (- j 1)))
          (set! j (- j 1)))
        (set! (mut xs) j x)))))

;;; The names in `dir` ending in `suffix`, sorted.
(defn coil-files-in [(dir (slice u8)) (suffix (slice u8))]
  (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (match (fs/Directory::list (malloc-allocator) dir)
      (Ok [names]
          (for i (range 0 (len names))
            (let [nm (get names i)]
              (when (ends-with? nm suffix) (push! (mut out) nm))))
          0)
      (Err [_] 0))
    (sort-strings! (mut out))
    out))
