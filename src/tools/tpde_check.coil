;;; tpde-check: differential tests of this port against the C++ TPDE
;;; reference (`ref/`), and the TIR generator they use. Run from the
;;; repository root after `coil build` (build/tpde-test) and `ref/build.sh`.
;;;
;;;   tpde-check parity [--fuzz N]
;;;       Every TPDE filetest RUN line that only invokes `tpde_test` (parser and
;;;       analyzer tests) runs with the reference and with ours; stdout and exit
;;;       status must match. With --fuzz, also N random programs through the
;;;       analyzer (RPO, layout, loops, liveness).
;;;   tpde-check codegen
;;;       Every `--target=aarch64` codegen RUN line: both objects disassembled
;;;       and normalized (symbols, no addresses), then compared. A difference is
;;;       reported, not a failure: where we deviate from TPDE on purpose
;;;       (docs/PLAN.md) the code differs.
;;;   tpde-check enc
;;;       Every instruction tests/enc_a64.coil and tests/enc_x64.coil encode
;;;       must disassemble with llvm-mc to the text written beside it.
;;;   tpde-check exec
;;;       Every tests/tir/NAME.tir with a NAME.c driver, compiled, linked and
;;;       run; and tests/cir_test.coil (the CIR builder) with tests/cir_test.c.
;;;   tpde-check all
;;;       parity --fuzz 500, codegen, enc and exec.
;;;   tpde-check gen random [--seed S] [--funcs N] [--blocks B]
;;;   tpde-check gen scale KIND N
;;;       Print a TIR program: random CFGs (loops, irreducible regions,
;;;       unreachable blocks, PHIs; SSA-valid), or the scaling inputs
;;;       many-values, many-blocks, loop-nest, many-funcs, switch.
(module tpde.tools.tpde-check)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.args" :as args)
(import "coil.fs" :as fs)
(import "coil.str" :use [StrBuf parse-int from-cstr])
(import "coil.slice" :use [subslice])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "tpde.tools.proc" :use *)

(extern tpde.tools.check.getenv :as "getenv" [(ptr i8)] (-> (ptr i8)))

(const OURS "build/tpde-test")
(const REF "ref/build/tpde/tpde_test")
(const TMP "/tmp/tpde-check")
(const OBJDUMP "/opt/homebrew/opt/llvm/bin/llvm-objdump")
(const LLVM-MC "/opt/homebrew/opt/llvm/bin/llvm-mc")

(defn tpde-dir [] (-> (slice u8))
  (cat2 (from-cstr (tpde.tools.check.getenv c"HOME")) "/Documents/Code/open-source/tpde"))

(defn new-list [] (-> (ArrayList (slice u8))) (ArrayList::new [(slice u8)] (malloc-allocator)))

; ============================ random numbers ================================
; splitmix64: the generator only needs to be deterministic per seed.

(defstruct Rng [(state u64)])

(defn rng-next! [(r (ptr Rng))] (-> u64)
  (set! (.state r) (+ (.state r) (: 0x9E3779B97F4A7C15 u64)))
  (let [(mut z) (.state r)]
    (set! z (* (^ z (>> z (: 30 u64))) (: 0xBF58476D1CE4E5B9 u64)))
    (set! z (* (^ z (>> z (: 27 u64))) (: 0x94D049BB133111EB u64)))
    (^ z (>> z (: 31 u64)))))

;;; Uniform in lo..=hi.
(defn randint [(r (ptr Rng)) (lo i64) (hi i64)] (-> i64)
  (+ lo (primitive/cast i64 (% (rng-next! r) (primitive/cast u64 (+ (- hi lo) 1))))))

;;; True with probability pct/100.
(defn chance [(r (ptr Rng)) (pct i64)] (-> bool) (< (randint r 0 99) pct))

(defn choose [(r (ptr Rng)) (xs (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (get (load xs) (randint r 0 (- (len (load xs)) 1))))

;;; `k` distinct elements of `xs`, in random order.
(defn sample [(r (ptr Rng)) (xs (ptr (ArrayList (slice u8)))) (k i64)] (-> (ArrayList (slice u8)))
  (let [(mut pool) (new-list)
        (mut out) (new-list)]
    (for i (range 0 (len (load xs))) (push! (mut pool) (get (load xs) i)))
    (for i (range 0 k)
      (let [j (randint r i (- (len pool) 1))
            t (get pool i)]
        (set! (mut pool) i (get pool j))
        (set! (mut pool) j t)
        (push! (mut out) (get pool i))))
    out))

; ============================ TIR generation ================================

(defn name-n [(prefix (slice u8)) (n i64)] (-> (slice u8))
  (let [(mut b) (StrBuf::new (malloc-allocator))]
    (push-str! (mut b) prefix)
    (push-i64! (mut b) n)
    (finish! (mut b))))

;;; `%a, %b, ...`
(defn push-uses! [(b (mut StrBuf)) (uses (ArrayList (slice u8)))] (-> void)
  (for i (range 0 (len uses))
    (when (> i 0) (push-str! (mut b) ", "))
    (push-str! (mut b) "%")
    (push-str! (mut b) (get uses i))))

(defn random-func [(r (ptr Rng)) (b (mut StrBuf)) (name (slice u8)) (max-blocks i64)] (-> void)
  (let [nargs (randint r 0 4)
        nblocks (randint r 1 max-blocks)
        (mut fargs) (new-list)
        (mut succs) (ArrayList::new [(ArrayList i64)] (malloc-allocator))
        (mut preds) (ArrayList::new [(ArrayList i64)] (malloc-allocator))
        (mut globals) (new-list)
        (mut counter) 0]
    (for i (range 0 nargs) (push! (mut fargs) (name-n "a" i)) (push! (mut globals) (name-n "a" i)))
    (push-str! (mut b) name)
    (push-str! (mut b) "(")
    (push-uses! (mut b) fargs)
    (push-str! (mut b) ") {\n")
    ; successors: never the entry; sometimes none (a return)
    (for i (range 0 nblocks)
      (let [(mut ss) (ArrayList::new [i64] (malloc-allocator))]
        (unless (or (= nblocks 1) (chance r 15))
          (let [ks [1 1 2 2 2 3 5]
                k (get ks (randint r 0 6))]
            (for _ (range 0 k) (push! (mut ss) (randint r 1 (- nblocks 1))))))
        (push! (mut succs) ss)
        (push! (mut preds) (ArrayList::new [i64] (malloc-allocator)))))
    (for i (range 0 nblocks)
      (let [ss (get succs i)]
        (for k (range 0 (len ss))
          (let [s (get ss k)
                (mut seen) false]
            (for q (range 0 (len (get preds s))) (when (= (get (get preds s) q) i) (set! seen true)))
            (unless seen (push! (mut (elem (mut preds) s)) i))))))
    (for i (range 0 nblocks)
      (let [(mut local) (new-list)
            ps (get preds i)]
        (push-str! (mut b) (name-n "b" i))
        (push-str! (mut b) ":\n")
        ; PHIs, taking from global values or each predecessor's own value
        (when (and (> i 0) (> (len ps) 0) (chance r 60))
          (for _ (range 0 (randint r 1 3))
            (set! counter (+ counter 1))
            (let [v (name-n "v" counter)]
              (push-str! (mut b) "  %")
              (push-str! (mut b) v)
              (push-str! (mut b) " = phi ")
              (for q (range 0 (len ps))
                (let [p (get ps q)
                      src (if (or (chance r 50) (= (len globals) 0)) (name-n "lv" p) (choose r (mut globals)))]
                  (when (> q 0) (push-str! (mut b) ", "))
                  (push-str! (mut b) "[^")
                  (push-str! (mut b) (name-n "b" p))
                  (push-str! (mut b) ", %")
                  (push-str! (mut b) src)
                  (push-str! (mut b) "]")))
              (push-str! (mut b) "\n")
              (push! (mut local) v))))
        ; every block defines lv<i> so PHIs in successors can name it
        (let [(mut ops) (new-list)]
          (for q (range 0 (len local)) (push! (mut ops) (get local q)))
          (for q (range 0 (len globals)) (push! (mut ops) (get globals q)))
          (let [k (randint r 0 3)
                uses (sample r (mut ops) (if (< (len ops) k) (len ops) k))]
            (push-str! (mut b) "  %")
            (push-str! (mut b) (name-n "lv" i))
            (push-str! (mut b) " =")
            (when (> (len uses) 0) (push-str! (mut b) " ") (push-uses! (mut b) uses))
            (push-str! (mut b) "\n")))
        (push! (mut local) (name-n "lv" i))
        (for _ (range 0 (randint r 0 4))
          (set! counter (+ counter 1))
          (let [v (name-n "v" counter)
                (mut pool) (new-list)]
            (for q (range 0 (len local)) (push! (mut pool) (get local q)))
            (for q (range 0 (len globals)) (push! (mut pool) (get globals q)))
            (let [k (randint r 0 3)
                  uses (sample r (mut pool) (if (< (len pool) k) (len pool) k))]
              (if (and (= i 0) (chance r 15))
                  (let [sizes [1 8 16]
                        aligns [1 8]]
                    (push-str! (mut b) "  %")
                    (push-str! (mut b) v)
                    (push-str! (mut b) " = alloca ")
                    (push-i64! (mut b) (get sizes (randint r 0 2)))
                    (push-str! (mut b) ", ")
                    (push-i64! (mut b) (get aligns (randint r 0 1)))
                    (push-str! (mut b) "\n"))
                  (do (push-str! (mut b) "  %")
                      (push-str! (mut b) v)
                      (push-str! (mut b) " =")
                      (when (> (len uses) 0) (push-str! (mut b) " ") (push-uses! (mut b) uses))
                      (push-str! (mut b) "\n")
                      (push! (mut local) v))))))
        (when (= i 0) (for q (range 0 (len local)) (push! (mut globals) (get local q))))
        (let [ss (get succs i)]
          (cond
            (= (len ss) 0)
              (if (chance r 50)
                  (push-str! (mut b) "  terminate\n")
                  (do (push-str! (mut b) "  ret %") (push-str! (mut b) (choose r (mut local))) (push-str! (mut b) "\n")))
            (and (= (len ss) 1) (chance r 50))
              (do (push-str! (mut b) "  br ^") (push-str! (mut b) (name-n "b" (get ss 0))) (push-str! (mut b) "\n"))
            :else
              (do (push-str! (mut b) "  jump ")
                  (for q (range 0 (len ss))
                    (when (> q 0) (push-str! (mut b) ", "))
                    (push-str! (mut b) "^")
                    (push-str! (mut b) (name-n "b" (get ss q))))
                  (push-str! (mut b) "\n"))))))
    (push-str! (mut b) "}\n")))

(defn gen-random [(seed i64) (funcs i64) (max-blocks i64)] (-> (slice u8))
  (let [(mut r) (Rng :state (primitive/cast u64 seed))
        (mut b) (StrBuf::new (malloc-allocator))]
    (for i (range 0 funcs)
      (when (> i 0) (push-str! (mut b) "\n"))
      (random-func (mut r) (mut b) (name-n "f" i) max-blocks))
    (finish! (mut b))))

(defn line! [(b (mut StrBuf)) (s (slice u8))] (-> void) (push-str! (mut b) s) (push-str! (mut b) "\n"))

(defn gen-scale [(kind (slice u8)) (n i64)] (-> (Option (slice u8)))
  (let [(mut b) (StrBuf::new (malloc-allocator))]
    (cond
      (= kind "many-values")
        (do (line! (mut b) "f(%a) {\nentry:")
            (for i (range 0 n)
              (push-str! (mut b) "  %v") (push-i64! (mut b) i)
              (push-str! (mut b) (if (= i 0) " = add %a, %a\n" " = add %v"))
              (when (> i 0) (push-i64! (mut b) (- i 1)) (push-str! (mut b) ", %a\n")))
            (push-str! (mut b) "  ret %v") (push-i64! (mut b) (- n 1)) (line! (mut b) "\n}")
            (Some (finish! (mut b))))
      (= kind "many-blocks")
        (do (line! (mut b) "f(%a) {")
            (for i (range 0 n)
              (push-str! (mut b) "b") (push-i64! (mut b) i) (push-str! (mut b) ":\n  %v") (push-i64! (mut b) i)
              (line! (mut b) " = add %a, %a")
              (if (< (+ i 1) n)
                  (do (push-str! (mut b) "  condbr %v") (push-i64! (mut b) i) (push-str! (mut b) ", ^b")
                      (push-i64! (mut b) (+ i 1)) (push-str! (mut b) ", ^b") (push-i64! (mut b) n) (line! (mut b) ""))
                  (do (push-str! (mut b) "  br ^b") (push-i64! (mut b) n) (line! (mut b) ""))))
            (push-str! (mut b) "b") (push-i64! (mut b) n) (line! (mut b) ":\n  ret %a\n}")
            (Some (finish! (mut b))))
      (= kind "loop-nest")
        (do (line! (mut b) "f(%a) {\nentry:\n  br ^h0")
            (for i (range 0 n)
              (push-str! (mut b) "h") (push-i64! (mut b) i) (push-str! (mut b) ":\n  %p") (push-i64! (mut b) i)
              (push-str! (mut b) " = phi [^")
              (if (= i 0) (push-str! (mut b) "entry") (do (push-str! (mut b) "h") (push-i64! (mut b) (- i 1))))
              (push-str! (mut b) ", %a], [^l") (push-i64! (mut b) i) (push-str! (mut b) ", %q") (push-i64! (mut b) i)
              (line! (mut b) "]")
              (push-str! (mut b) "  %q") (push-i64! (mut b) i) (push-str! (mut b) " = add %p") (push-i64! (mut b) i)
              (line! (mut b) ", %a")
              (push-str! (mut b) "  condbr %q") (push-i64! (mut b) i) (push-str! (mut b) ", ^")
              (if (< (+ i 1) n) (do (push-str! (mut b) "h") (push-i64! (mut b) (+ i 1))) (push-str! (mut b) "inner"))
              (push-str! (mut b) ", ^l") (push-i64! (mut b) i) (line! (mut b) ""))
            (push-str! (mut b) "inner:\n  %x = add %a, %a\n  br ^l") (push-i64! (mut b) (- n 1)) (line! (mut b) "")
            (let [(mut i) (- n 1)]
              (while (>= i 0)
                (push-str! (mut b) "l") (push-i64! (mut b) i) (push-str! (mut b) ":\n  condbr %a, ^h")
                (push-i64! (mut b) i) (push-str! (mut b) ", ^")
                (if (> i 0) (do (push-str! (mut b) "l") (push-i64! (mut b) (- i 1))) (push-str! (mut b) "exit"))
                (line! (mut b) "")
                (set! i (- i 1))))
            (line! (mut b) "exit:\n  ret %a\n}")
            (Some (finish! (mut b))))
      (= kind "many-funcs")
        (do (for i (range 0 n)
              (push-str! (mut b) "f") (push-i64! (mut b) i)
              (line! (mut b) "(%a, %b) {\nentry:\n  %c = add %a, %b\n  %d = sub %c, %a\n  ret %d\n}"))
            (Some (finish! (mut b))))
      (= kind "switch")
        (do (push-str! (mut b) "f(%a) {\nentry:\n  jump ")
            (for i (range 0 n) (push-str! (mut b) "^c") (push-i64! (mut b) i) (push-str! (mut b) ", "))
            (line! (mut b) "^exit")
            (for i (range 0 n)
              (push-str! (mut b) "c") (push-i64! (mut b) i) (push-str! (mut b) ":\n  %v") (push-i64! (mut b) i)
              (line! (mut b) " = add %a, %a\n  br ^exit"))
            (push-str! (mut b) "exit:\n  %r = phi ")
            (for i (range 0 n)
              (push-str! (mut b) "[^c") (push-i64! (mut b) i) (push-str! (mut b) ", %v") (push-i64! (mut b) i)
              (push-str! (mut b) "], "))
            (line! (mut b) "[^entry, %a]\n  ret %r\n}")
            (Some (finish! (mut b))))
      :else (None [(slice u8)]))))

; ============================ RUN lines =====================================

;;; The `; RUN:` commands of a filetest.
(defn run-lines [(text (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (new-list)
        ls (lines text)]
    (for i (range 0 (len ls))
      (let [ws (words (get ls i))]
        (when (and (>= (len ws) 2) (= (get ws 0) ";") (= (get ws 1) "RUN:"))
          ; the text after "RUN:"
          (let [l (get ls i)
                (mut k) 0]
            (while (and (< (+ k 4) (len l)) (not (= (subslice l k (+ k 4)) "RUN:"))) (set! k (+ k 1)))
            (push! (mut out) (subslice l (+ k 4) (len l)))))))
    out))

;;; A RUN command's words up to the first `|`.
(defn first-command [(run (slice u8))] (-> (ArrayList (slice u8)))
  (let [ws (words run)
        (mut out) (new-list)]
    (block :done
      (for i (range 0 (len ws))
        (when (= (get ws i) "|") (return-from :done 0))
        (push! (mut out) (get ws i)))
      0)
    out))

(defstruct Case [(args (ArrayList (slice u8))) (expect-fail bool)])

;;; The `tpde_test` arguments of a parser/analyzer RUN line (`%s` replaced by
;;; `path`), or None for anything else (codegen tests, other tools).
(defn analyzer-case [(run (slice u8)) (path (slice u8))] (-> (Option Case))
  (let [ws0 (first-command run)
        fail (and (> (len ws0) 0) (= (get ws0 0) "not"))
        start (if fail 1 0)]
    (if (or (<= (len ws0) start)
            (not (or (= (get ws0 start) "%tpde_test") (= (get ws0 start) "tpde_test"))))
        (None [Case])
        (let [(mut av) (new-list)
              (mut analysis) false]
          (for i (range (+ start 1) (len ws0))
            (let [w (get ws0 i)]
              (push! (mut av) (if (= w "%s") path w))
              (when (or (= w "--print-ir") (and (starts-with? w "--run-until=") (not (= w "--run-until=full"))))
                (set! analysis true))))
          (if analysis (Some (Case :args av :expect-fail fail)) (None [Case]))))))

(defn show-args [(av (ArrayList (slice u8))) (path (slice u8))] (-> (slice u8))
  (let [(mut b) (StrBuf::new (malloc-allocator))]
    (for i (range 0 (len av))
      (let [w (get av i)]
        (unless (= w path) (push-str! (mut b) " ") (push-str! (mut b) w))))
    (finish! (mut b))))

;;; The first line where `a` and `b` differ.
(defn first-diff [(a (slice u8)) (b (slice u8))] (-> void)
  (let [la (lines a)
        lb (lines b)
        n (if (> (len la) (len lb)) (len la) (len lb))]
    (block :done
      (for i (range 0 n)
        (let [x (if (< i (len la)) (get la i) "<eof>")
              y (if (< i (len lb)) (get lb i) "<eof>")]
          (unless (= x y)
            (println "  line {}:\n    ref:  {}\n    ours: {}" (+ i 1) x y)
            (return-from :done 0))))
      0)))

(defn tir-files [(dirs (ptr (ArrayList (slice u8))))] (-> (ArrayList (slice u8)))
  (let [(mut out) (new-list)]
    (for d (range 0 (len (load dirs)))
      (let [dir (get (load dirs) d)
            names (coil-files-in dir ".tir")]
        (for i (range 0 (len names)) (push! (mut out) (cat3 dir "/" (get names i))))))
    out))

; ============================ parity ========================================

(defn parity [(fuzz i64)] (-> i64)
  (let [tp (tpde-dir)
        (mut dirs) (new-list)
        (mut passed) 0
        (mut failed) 0
        (mut skipped) 0]
    (push! (mut dirs) (cat2 tp "/tpde/test/filetest/analyzer"))
    (push! (mut dirs) (cat2 tp "/tpde/test/filetest/tir"))
    (push! (mut dirs) "tests/tir")
    (let [files (tir-files (mut dirs))]
      (for fi (range 0 (len files))
        (let [path (get files fi)
              (mut cases) (ArrayList::new [Case] (malloc-allocator))]
          (match (read-text path)
            (Some [text]
                  (let [runs (run-lines text)]
                    (for k (range 0 (len runs))
                      (match (analyzer-case (get runs k) path)
                        (Some [c] (push! (mut cases) c))
                        (None [] 0)))))
            (None [] 0))
          (if (= (len cases) 0)
              (set! skipped (+ skipped 1))
              (for k (range 0 (len cases))
                (let [c (get cases k)
                      r (run-cmd REF (argv-of (.args c)) 120)
                      o (run-cmd OURS (argv-of (.args c)) 120)
                      same-status (= (= (.code r) 0) (= (.code o) 0))]
                  ; a failing run's output is the reference's timestamped log;
                  ; only the status is compared
                  (if (and same-status (or (!= (.code r) 0) (= (.out r) (.out o))))
                      (set! passed (+ passed 1))
                      (do (set! failed (+ failed 1))
                          (println "FAIL {}{}" path (show-args (.args c) path))
                          (println "  exit: ref {}, ours {}" (.code r) (.code o))
                          (unless (= (.out r) (.out o)) (first-diff (.out r) (.out o)))))))))))
    (println "parity: {} passed, {} failed, {} files without analyzer RUN lines" passed failed skipped)
    (when (> fuzz 0)
      (let [(mut fz-fail) 0
            blocks [3 6 12 30 80]]
        (for seed (range 0 fuzz)
          (let [path (cat3 TMP "/fuzz" (cat2 (name-n "" seed) ".tir"))
                (mut av) (list1 "--run-until=analyzer")]
            (write-text path (gen-random seed 10 (get blocks (% seed 5))))
            (push! (mut av) "--print-rpo")
            (push! (mut av) "--print-layout")
            (push! (mut av) "--print-loops")
            (push! (mut av) "--print-liveness")
            (push! (mut av) path)
            (let [r (run-cmd REF (argv-of av) 120)
                  o (run-cmd OURS (argv-of av) 120)]
              (unless (and (= (.code r) (.code o)) (= (.out r) (.out o)))
                (set! fz-fail (+ fz-fail 1))
                (println "FUZZ FAIL seed {} (exit ref {}, ours {}); kept {}" seed (.code r) (.code o) path)))))
        (println "fuzz: {} passed, {} failed" (- fuzz fz-fail) fz-fail)
        (set! failed (+ failed fz-fail))))
    (if (= failed 0) 0 1)))

; ============================ codegen differential ===========================

;;; llvm-objdump's disassembly of `obj` with the noise taken out: no file
;;; header, no addresses or raw bytes, no padding, symbols without Mach-O's
;;; leading underscore.
(defn disasm [(obj (slice u8))] (-> (slice u8))
  (let [(mut av) (list1 "-d")]
    (push! (mut av) "--no-show-raw-insn")
    (push! (mut av) "--symbolize-operands")
    (push! (mut av) "--no-addresses")
    (push! (mut av) obj)
    (let [r (run-cmd OBJDUMP (argv-of av) 60)
          ls (lines (.out r))
          (mut b) (StrBuf::new (malloc-allocator))]
      (for i (range 0 (len ls))
        (let [l (get ls i)
              ws (words l)]
          (unless (or (= (len ws) 0)
                      (contains-text? l "file format") (contains-text? l "Disassembly of")
                      (and (= (len ws) 1) (= (get ws 0) "..."))
                      (contains-text? l "udf"))
            (let [cut (strip-comment l)]
              (push-str! (mut b) (replace-all cut "<_" "<"))
              (push-str! (mut b) "\n")))))
      (finish! (mut b)))))

(defn contains-text? [(s (slice u8)) (needle (slice u8))] (-> bool)
  (let [n (len needle)]
    (block :found
      (for i (range 0 (+ (- (len s) n) 1))
        (when (= (subslice s i (+ i n)) needle) (return-from :found true)))
      false)))

;;; `s` without a trailing `// comment` and the spaces before it.
(defn strip-comment [(s (slice u8))] (-> (slice u8))
  (let [(mut end) (len s)]
    (block :found
      (for i (range 0 (- (len s) 1))
        (when (and (= (get s i) #\/) (= (get s (+ i 1)) #\/)) (set! end i) (return-from :found 0)))
      0)
    (while (and (> end 0) (space? (get s (- end 1)))) (set! end (- end 1)))
    (subslice s 0 end)))

(defn replace-all [(s (slice u8)) (from (slice u8)) (to (slice u8))] (-> (slice u8))
  (let [(mut b) (StrBuf::new (malloc-allocator))
        n (len from)
        (mut i) 0]
    (while (< i (len s))
      (if (and (<= (+ i n) (len s)) (= (subslice s i (+ i n)) from))
          (do (push-str! (mut b) to) (set! i (+ i n)))
          (do (push-str! (mut b) (subslice s i (+ i 1))) (set! i (+ i 1)))))
    (finish! (mut b))))

(defn codegen [] (-> i64)
  (let [tp (tpde-dir)
        (mut dirs) (new-list)
        (mut same) 0
        (mut differ) 0
        (mut broken) 0]
    (push! (mut dirs) (cat2 tp "/tpde/test/filetest/codegen"))
    (push! (mut dirs) "tests/tir")
    (let [files (tir-files (mut dirs))]
      (for fi (range 0 (len files))
        (let [path (get files fi)]
          (match (read-text path)
            (Some [text]
                  (let [runs (run-lines text)]
                    (for k (range 0 (len runs))
                      (let [run (get runs k)
                            ws (first-command run)]
                        (when (and (contains-text? run "--target=aarch64") (contains-text? run "%objdump")
                                   (> (len ws) 0) (or (= (get ws 0) "tpde_test") (= (get ws 0) "%tpde_test")))
                          (let [(mut av) (new-list)]
                            (for i (range 1 (len ws)) (push! (mut av) (if (= (get ws i) "%s") path (get ws i))))
                            (let [r (run-cmd REF (argv-of av) 120)
                                  refobj (cat2 TMP "/ref.o")
                                  ourobj (cat2 TMP "/ours.o")
                                  (mut ov) (new-list)]
                              ; a fresh list: a copy of `av` would share (and regrow) its buffer
                              (for i (range 0 (len av)) (push! (mut ov) (get av i)))
                              (push! (mut ov) "-o")
                              (push! (mut ov) ourobj)
                              (write-text refobj (.out r))
                              (let [o (run-cmd OURS (argv-of ov) 120)]
                                (if (or (!= (.code r) 0) (!= (.code o) 0))
                                    (do (set! broken (+ broken 1))
                                        (println "FAIL {}{}: exit ref {}, ours {}" path (show-args av path) (.code r) (.code o)))
                                    (let [dr (disasm refobj)
                                          do- (disasm ourobj)]
                                      (if (= dr do-)
                                          (set! same (+ same 1))
                                          (do (set! differ (+ differ 1))
                                              (println "differs: {}{}" path (show-args av path))
                                              (first-diff dr do-))))))))))))
                  0)
            (None [] 0)))))
    (println "codegen: {} identical to the reference, {} differ, {} failed to compile" same differ broken)
    (if (= broken 0) 0 1)))

; ============================ encoder ========================================

(defn enc [] (-> i64)
  (let [(mut t1) (list1 "-triple=aarch64")
        (mut t2) (list1 "-triple=x86_64")]
    (push! (mut t1) "-mattr=+lse")
    (push! (mut t2) "-output-asm-variant=1")
    (+ (enc-one "a64" t1) (enc-one "x64" t2))))

;;; Build and run tests/enc_NAME.coil, then disassemble its bytes with llvm-mc.
(defn enc-one [(name (slice u8)) (flags (ArrayList (slice u8)))] (-> i64)
  (let [src (cat3 "tests/enc_" name ".coil")
        exe (cat2 "build/enc_" name)
        (mut bv) (list1 "build")
        _ (do (push! (mut bv) src) (push! (mut bv) "-o") (push! (mut bv) exe)
              (push! (mut bv) "--quiet") 0)
        b (run-cmd "coil" (argv-of bv) 600)
        r (if (= (.code b) 0) (run-cmd exe (argv-of (new-list)) 60) b)
        ls (lines (.out r))
        (mut input) (StrBuf::new (malloc-allocator))
        (mut want) (new-list)]
    (if (!= (.code r) 0)
        (do (eprintln "enc: building or running {} failed\n{}" src (.err r)) 1)
        (do
          (for i (range 0 (len ls))
            (let [l (get ls i)
                  (mut k) 0]
              (while (and (< k (len l)) (!= (get l k) #\;)) (set! k (+ k 1)))
              (when (< k (len l))
                (push-str! (mut input) (subslice l 0 k))
                (push-str! (mut input) "\n")
                (push! (mut want) (strip-comment (subslice l (+ k 2) (len l)))))))
          (let [bytes (cat3 TMP "/enc-" (cat2 name ".txt"))]
            (write-text bytes (finish! (mut input)))
            (let [(mut av) (list1 "--disassemble")]
              (for i (range 0 (len flags)) (push! (mut av) (get flags i)))
              (push! (mut av) bytes)
              (let [m (run-cmd LLVM-MC (argv-of av) 60)
                    out (lines (.out m))
                    (mut got) (new-list)
                    (mut bad) 0]
                (let [(mut pending) ""]
                  (for i (range 0 (len out))
                    (let [ws (words (get out i))]
                      (unless (or (= (len ws) 0) (= (get ws 0) ".text") (starts-with? (get ws 0) ".intel_syntax"))
                        (let [text (canon-asm (strip-comment (get out i)))]
                          ; x86 prefixes come out on a line of their own
                          (if (= text "lock")
                              (set! pending "lock ")
                              (do (push! (mut got) (cat2 pending text)) (set! pending ""))))))))
                (if (!= (len got) (len want))
                    (do (println "enc {}: llvm-mc gave {} instructions for {}:\n{}" name (len got) (len want) (.err m))
                        (for i (range 0 (if (< (len got) (len want)) (len got) (len want)))
                          (unless (= (get got i) (get want i))
                            (println "  first difference: want [{}] got [{}]" (get want i) (get got i))))
                        1)
                    (do (for i (range 0 (len want))
                          (unless (= (get got i) (get want i))
                            (println "MISMATCH {}: want [{}] got [{}]" name (get want i) (get got i))
                            (set! bad (+ bad 1))))
                        (println "encoder {}: {} checked, {} mismatched" name (len want) bad)
                        (if (= bad 0) 0 1))))))))))

;;; llvm-mc's `\tadd\tx0, x1` as `add x0, x1`.
(defn canon-asm [(s (slice u8))] (-> (slice u8))
  (let [(mut b) (StrBuf::new (malloc-allocator))
        (mut i) 0]
    (while (and (< i (len s)) (space? (get s i))) (set! i (+ i 1)))
    (while (< i (len s))
      (push-str! (mut b) (if (= (get s i) #\tab) " " (subslice s i (+ i 1))))
      (set! i (+ i 1)))
    (finish! (mut b))))

; ============================ TIR execution =================================

;;; Each tests/tir/NAME.tir with a NAME.c driver: compiled by us, linked with
;;; the driver, run; the driver prints `ok` when every result is right.
(defn exec-tests [] (-> i64)
  (let [names (coil-files-in "tests/tir" ".c")
        (mut bad) 0]
    (for i (range 0 (len names))
      (let [nm (get names i)
            base (subslice nm 0 (- (len nm) 2))
            tir (cat3 "tests/tir/" base ".tir")
            obj (cat3 TMP "/" (cat2 base ".o"))
            exe (cat3 TMP "/" base)
            (mut av) (list1 "--target=aarch64")]
        (push! (mut av) tir)
        (push! (mut av) "-o")
        (push! (mut av) obj)
        (let [c (run-cmd OURS (argv-of av) 120)
              (mut lv) (list1 (cat2 "tests/tir/" nm))]
          (push! (mut lv) obj)
          (push! (mut lv) "-o")
          (push! (mut lv) exe)
          (let [l (if (= (.code c) 0) (run-cmd "cc" (argv-of lv) 120) c)
                r (if (= (.code l) 0) (run-cmd exe (argv-of (new-list)) 60) l)]
            (if (and (= (.code r) 0) (= (.out r) "ok\n"))
                (println "ok   {}" base)
                (do (println "FAIL {}: exit {}\n{}{}" base (.code r) (.out r) (.err r))
                    (set! bad (+ bad 1))))))))
    (if (= bad 0) 0 1)))

;;; tests/cir_test.coil builds CIR functions with the builder (Braun SSA) and
;;; compiles them to build/cir_test.o; tests/cir_test.c calls and checks them.
(defn cir-test [] (-> i64)
  (let [(mut bv) (list1 "build")]
    (push! (mut bv) "tests/cir_test.coil")
    (push! (mut bv) "-o")
    (push! (mut bv) "build/cir_test")
    (push! (mut bv) "--quiet")
    (let [b (run-cmd "coil" (argv-of bv) 600)
          g (if (= (.code b) 0) (run-cmd "build/cir_test" (argv-of (new-list)) 60) b)
          (mut lv) (list1 "tests/cir_test.c")]
      (push! (mut lv) "build/cir_test.o")
      (push! (mut lv) "-o")
      (push! (mut lv) (cat2 TMP "/cir_test"))
      (let [l (if (= (.code g) 0) (run-cmd "cc" (argv-of lv) 120) g)
            r (if (= (.code l) 0) (run-cmd (cat2 TMP "/cir_test") (argv-of (new-list)) 60) l)]
        (if (and (= (.code r) 0) (= (.out r) "ok\n"))
            (do (println "ok   cir_test") 0)
            (do (println "FAIL cir_test: exit {}\n{}{}" (.code r) (.out r) (.err r)) 1))))))

; ============================ main ===========================================

(defn arg-at [(i i64)] (-> (slice u8)) (if (< i (args/count)) (args/nth i) ""))

(defn int-arg [(i i64) (default i64)] (-> i64)
  (match (parse-int (arg-at i)) (Some [v] v) (None [] default)))

(defn usage [] (-> i64)
  (eprintln "usage: tpde-check parity [--fuzz N]")
  (eprintln "       tpde-check codegen")
  (eprintln "       tpde-check enc")
  (eprintln "       tpde-check exec")
  (eprintln "       tpde-check all")
  (eprintln "       tpde-check gen random [--seed S] [--funcs N] [--blocks B]")
  (eprintln "       tpde-check gen scale KIND N")
  2)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (fs/create-dir (malloc-allocator) TMP 493)
  (let [cmd (arg-at 1)]
    (cond
      (= cmd "parity") (parity (if (= (arg-at 2) "--fuzz") (int-arg 3 0) 0))
      (= cmd "codegen") (codegen)
      (= cmd "enc") (enc)
      (= cmd "exec") (+ (exec-tests) (cir-test))
      (= cmd "all")
        (let [a (parity 500) b (codegen) c (enc) d (exec-tests) e (cir-test)]
          (if (= (+ (+ (+ a b) (+ c d)) e) 0) (do (println "all package checks pass") 0) 1))
      (and (= cmd "gen") (= (arg-at 2) "random"))
        (let [(mut seed) 0 (mut funcs) 20 (mut blocks) 12 (mut i) 3]
          (while (< i (args/count))
            (cond (= (arg-at i) "--seed") (set! seed (int-arg (+ i 1) 0))
                  (= (arg-at i) "--funcs") (set! funcs (int-arg (+ i 1) 20))
                  (= (arg-at i) "--blocks") (set! blocks (int-arg (+ i 1) 12))
                  :else 0)
            (set! i (+ i 2)))
          (print "{}" (gen-random seed funcs blocks))
          0)
      (and (= cmd "gen") (= (arg-at 2) "scale"))
        (match (gen-scale (arg-at 3) (int-arg 4 1000))
          (Some [text] (do (print "{}" text) 0))
          (None [] (do (eprintln "unknown kind {}" (arg-at 3)) 2)))
      :else (usage))))
