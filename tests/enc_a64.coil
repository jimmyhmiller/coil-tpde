;;; Encoder check: prints `<4 bytes> ; <expected llvm-mc text>` per instruction.
;;; tests/check_enc.sh feeds the bytes to `llvm-mc --disassemble` and compares.
(module tpde.tests.enc-a64)
(import "tpde.a64.enc" :as e)
(import "coil.primitive" :as primitive)

(defn hexb [(x u32)] (-> void)
  (print "0x{:x} 0x{:x} 0x{:x} 0x{:x}" (& x (: 0xFF u32)) (& (>> x (: 8 u32)) (: 0xFF u32))
         (& (>> x (: 16 u32)) (: 0xFF u32)) (>> x (: 24 u32))))

(defn t [(x u32) (want (slice u8))] (-> void)
  (hexb x)
  (println " ; {}" want))

(defn u [(x i64)] (-> u32) (primitive/cast u32 x))

(defn main [] (-> i64)
  (t (e/add-imm true (u 0) (u 1) 16) "add x0, x1, #16")
  (t (e/add-imm false (u 3) (u 4) 4095) "add w3, w4, #4095")
  (t (e/add-imm true (u 31) (u 31) 4096) "add sp, sp, #1, lsl #12")
  (t (e/sub-imm true (u 31) (u 31) 32) "sub sp, sp, #32")
  (t (e/cmp-imm true (u 5) 7) "cmp x5, #7")
  (t (e/cmn-imm false (u 5) 1) "cmn w5, #1")
  (t (e/add-reg true (u 0) (u 1) (u 2)) "add x0, x1, x2")
  (t (e/sub-reg false (u 0) (u 1) (u 2)) "sub w0, w1, w2")
  (t (e/subs-reg true (u 0) (u 1) (u 2)) "subs x0, x1, x2")
  (t (e/cmp-reg true (u 1) (u 2)) "cmp x1, x2")
  (t (e/add-lsl true (u 0) (u 1) (u 2) (u 3)) "add x0, x1, x2, lsl #3")
  (t (e/neg-reg true (u 0) (u 1)) "neg x0, x1")
  (t (e/add-ext true (u 0) (u 29) (u 1) (u 2) (u 0)) "add x0, x29, w1, uxtw")
  (t (e/add-ext true (u 0) (u 1) (u 2) (u 6) (u 0)) "add x0, x1, w2, sxtw")
  (t (e/adds-reg true (u 0) (u 1) (u 2)) "adds x0, x1, x2")
  (t (e/adc true (u 0) (u 1) (u 2)) "adc x0, x1, x2")
  (t (e/sbc true (u 0) (u 1) (u 2)) "sbc x0, x1, x2")
  (t (e/and-reg true (u 0) (u 1) (u 2)) "and x0, x1, x2")
  (t (e/orr-reg false (u 0) (u 1) (u 2)) "orr w0, w1, w2")
  (t (e/eor-reg true (u 0) (u 1) (u 2)) "eor x0, x1, x2")
  (t (e/bic-reg true (u 0) (u 1) (u 2)) "bic x0, x1, x2")
  (t (e/mov-reg true (u 0) (u 1)) "mov x0, x1")
  (t (e/mov-reg false (u 0) (u 1)) "mov w0, w1")
  (t (e/mvn-reg true (u 0) (u 1)) "mvn x0, x1")
  (t (e/tst-reg true (u 0) (u 1)) "tst x0, x1")
  (t (e/mov-sp (u 29) (u 31)) "mov x29, sp")
  (t (e/and-imm true (u 0) (u 1) (e/logical-imm (: 0xFF u64) true)) "and x0, x1, #0xff")
  (t (e/and-imm false (u 0) (u 1) (e/logical-imm (: 0xFFFF u64) false)) "and w0, w1, #0xffff")
  (t (e/orr-imm true (u 0) (u 31) (e/logical-imm (: 0x5555555555555555 u64) true)) "mov x0, #6148914691236517205")
  (t (e/and-imm true (u 0) (u 1) (e/logical-imm (: 0xFFFFFFFFFFFFFFF0 u64) true)) "and x0, x1, #0xfffffffffffffff0")
  (t (e/eor-imm true (u 0) (u 1) (e/logical-imm (: 1 u64) true)) "eor x0, x1, #0x1")
  (t (e/and-imm true (u 0) (u 1) (e/logical-imm (: 0x8000000000000001 u64) true)) "and x0, x1, #0x8000000000000001")
  (t (e/ands-imm false (u 31) (u 3) (e/logical-imm (: 0x80000000 u64) false)) "tst w3, #0x80000000")
  (t (e/movz true (u 0) (u 0x1234) (u 1)) "mov x0, #305397760")
  (t (e/movk true (u 0) (u 0xbeef) (u 2)) "movk x0, #48879, lsl #32")
  (t (e/movn false (u 0) (u 0) (u 0)) "mov w0, #-1")
  (t (e/udiv true (u 0) (u 1) (u 2)) "udiv x0, x1, x2")
  (t (e/sdiv false (u 0) (u 1) (u 2)) "sdiv w0, w1, w2")
  (t (e/lslv true (u 0) (u 1) (u 2)) "lsl x0, x1, x2")
  (t (e/lsrv true (u 0) (u 1) (u 2)) "lsr x0, x1, x2")
  (t (e/asrv false (u 0) (u 1) (u 2)) "asr w0, w1, w2")
  (t (e/rorv true (u 0) (u 1) (u 2)) "ror x0, x1, x2")
  (t (e/mul true (u 0) (u 1) (u 2)) "mul x0, x1, x2")
  (t (e/madd true (u 0) (u 1) (u 2) (u 3)) "madd x0, x1, x2, x3")
  (t (e/msub true (u 0) (u 1) (u 2) (u 3)) "msub x0, x1, x2, x3")
  (t (e/smulh (u 0) (u 1) (u 2)) "smulh x0, x1, x2")
  (t (e/umulh (u 0) (u 1) (u 2)) "umulh x0, x1, x2")
  (t (e/umull (u 0) (u 1) (u 2)) "umull x0, w1, w2")
  (t (e/rbit true (u 0) (u 1)) "rbit x0, x1")
  (t (e/rev true (u 0) (u 1)) "rev x0, x1")
  (t (e/rev false (u 0) (u 1)) "rev w0, w1")
  (t (e/rev16 false (u 0) (u 1)) "rev16 w0, w1")
  (t (e/clz true (u 0) (u 1)) "clz x0, x1")
  (t (e/csel true (u 0) (u 1) (u 2) (u 0)) "csel x0, x1, x2, eq")
  (t (e/cset false (u 0) (u 11)) "cset w0, lt")
  (t (e/csetm true (u 0) (u 1)) "csetm x0, ne")
  (t (e/csinc true (u 0) (u 1) (u 2) (u 8)) "csinc x0, x1, x2, hi")
  (t (e/lsl-imm true (u 0) (u 1) (u 3)) "lsl x0, x1, #3")
  (t (e/lsl-imm false (u 0) (u 1) (u 31)) "lsl w0, w1, #31")
  (t (e/lsr-imm true (u 0) (u 1) (u 63)) "lsr x0, x1, #63")
  (t (e/asr-imm false (u 0) (u 1) (u 5)) "asr w0, w1, #5")
  (t (e/ubfx true (u 0) (u 1) (u 4) (u 8)) "ubfx x0, x1, #4, #8")
  (t (e/sbfx false (u 0) (u 1) (u 0) (u 7)) "sbfx w0, w1, #0, #7")
  (t (e/bfi true (u 0) (u 1) (u 8) (u 4)) "bfi x0, x1, #8, #4")
  (t (e/bfxil true (u 0) (u 1) (u 8) (u 4)) "bfxil x0, x1, #8, #4")
  (t (e/ubfiz true (u 0) (u 1) (u 8) (u 4)) "ubfiz x0, x1, #8, #4")
  (t (e/sxtb true (u 0) (u 1)) "sxtb x0, w1")
  (t (e/sxth false (u 0) (u 1)) "sxth w0, w1")
  (t (e/sxtw (u 0) (u 1)) "sxtw x0, w1")
  (t (e/uxtb (u 0) (u 1)) "uxtb w0, w1")
  (t (e/uxth (u 0) (u 1)) "uxth w0, w1")
  (t (e/ror-imm true (u 0) (u 1) (u 7)) "ror x0, x1, #7")
  (t (e/extr true (u 0) (u 1) (u 2) (u 7)) "extr x0, x1, x2, #7")
  (t (e/ldr-gp (u 0) (u 29) 16 (u 8) false) "ldr x0, [x29, #16]")
  (t (e/ldr-gp (u 0) (u 29) 6 (u 2) false) "ldrh w0, [x29, #6]")
  (t (e/ldr-gp (u 0) (u 1) 3 (u 1) true) "ldrsb x0, [x1, #3]")
  (t (e/ldr-gp (u 0) (u 1) 4 (u 4) true) "ldrsw x0, [x1, #4]")
  (t (e/ldr-gp (u 0) (u 1) -8 (u 8) false) "ldur x0, [x1, #-8]")
  (t (e/ldr-gp (u 0) (u 1) 3 (u 8) false) "ldur x0, [x1, #3]")
  (t (e/str-gp (u 0) (u 31) 8 (u 8)) "str x0, [sp, #8]")
  (t (e/str-gp (u 0) (u 1) 1 (u 1)) "strb w0, [x1, #1]")
  (t (e/str-gp (u 0) (u 1) 2 (u 4)) "stur w0, [x1, #2]")
  (t (e/ldr-fp (u 0) (u 29) 16 (u 8)) "ldr d0, [x29, #16]")
  (t (e/ldr-fp (u 1) (u 29) 4 (u 4)) "ldr s1, [x29, #4]")
  (t (e/ldr-fp (u 2) (u 29) 32 (u 16)) "ldr q2, [x29, #32]")
  (t (e/str-fp (u 2) (u 29) 32 (u 16)) "str q2, [x29, #32]")
  (t (e/str-fp (u 3) (u 1) -4 (u 4)) "stur s3, [x1, #-4]")
  (t (e/ldr-gp-reg (u 0) (u 1) (u 2) (u 8) false true) "ldr x0, [x1, x2, lsl #3]")
  (t (e/ldr-gp-reg (u 0) (u 1) (u 2) (u 1) false false) "ldrb w0, [x1, x2]")
  (t (e/str-gp-reg (u 0) (u 1) (u 2) (u 4) false) "str w0, [x1, x2]")
  (t (e/ldr-fp-reg (u 0) (u 1) (u 2) (u 8) true) "ldr d0, [x1, x2, lsl #3]")
  (t (e/stp-x-pre (u 29) (u 30) (u 31) -32) "stp x29, x30, [sp, #-32]!")
  (t (e/ldp-x-post (u 29) (u 30) (u 31) 32) "ldp x29, x30, [sp], #32")
  (t (e/stp-x (u 19) (u 20) (u 31) 16) "stp x19, x20, [sp, #16]")
  (t (e/ldp-x (u 19) (u 20) (u 31) 16) "ldp x19, x20, [sp, #16]")
  (t (e/stp-d (u 8) (u 9) (u 31) 32) "stp d8, d9, [sp, #32]")
  (t (e/ldp-q (u 0) (u 1) (u 31) 32) "ldp q0, q1, [sp, #32]")
  (t (e/b 4) "b #16")
  (t (e/b -1) "b #-4")
  (t (e/bl 0) "bl #0")
  (t (e/b-cond (u 1) 2) "b.ne #8")
  (t (e/cbz true (u 3) 2) "cbz x3, #8")
  (t (e/cbnz false (u 3) -2) "cbnz w3, #-8")
  (t (e/tbz (u 3) (u 33) 2) "tbz x3, #33, #8")
  (t (e/tbnz (u 3) (u 2) 2) "tbnz w3, #2, #8")
  (t (e/br (u 16)) "br x16")
  (t (e/blr (u 9)) "blr x9")
  (t (e/ret) "ret")
  (t (e/brk (u 1)) "brk #0x1")
  (t (e/adrp (u 16) 0) "adrp x16, #0")
  (t (e/adr (u 0) 8) "adr x0, #8")
  (t (e/dmb-ish) "dmb ish")
  (t (e/fadd false (u 0) (u 1) (u 2)) "fadd s0, s1, s2")
  (t (e/fsub true (u 0) (u 1) (u 2)) "fsub d0, d1, d2")
  (t (e/fmul true (u 0) (u 1) (u 2)) "fmul d0, d1, d2")
  (t (e/fdiv false (u 0) (u 1) (u 2)) "fdiv s0, s1, s2")
  (t (e/fminnm true (u 0) (u 1) (u 2)) "fminnm d0, d1, d2")
  (t (e/fmov-reg true (u 0) (u 1)) "fmov d0, d1")
  (t (e/fneg false (u 0) (u 1)) "fneg s0, s1")
  (t (e/fabs true (u 0) (u 1)) "fabs d0, d1")
  (t (e/fsqrt true (u 0) (u 1)) "fsqrt d0, d1")
  (t (e/frintm true (u 0) (u 1)) "frintm d0, d1")
  (t (e/frintz false (u 0) (u 1)) "frintz s0, s1")
  (t (e/frintn true (u 0) (u 1)) "frintn d0, d1")
  (t (e/frinta true (u 0) (u 1)) "frinta d0, d1")
  (t (e/frintp true (u 0) (u 1)) "frintp d0, d1")
  (t (e/fcvt-s2d (u 0) (u 1)) "fcvt d0, s1")
  (t (e/fcvt-d2s (u 0) (u 1)) "fcvt s0, d1")
  (t (e/fcmp true (u 0) (u 1)) "fcmp d0, d1")
  (t (e/fcmp-zero false (u 0)) "fcmp s0, #0.0")
  (t (e/fcsel true (u 0) (u 1) (u 2) (u 12)) "fcsel d0, d1, d2, gt")
  (t (e/fmadd true (u 0) (u 1) (u 2) (u 3)) "fmadd d0, d1, d2, d3")
  (t (e/scvtf true true (u 0) (u 1)) "scvtf d0, x1")
  (t (e/scvtf false false (u 0) (u 1)) "scvtf s0, w1")
  (t (e/ucvtf true false (u 0) (u 1)) "ucvtf s0, x1")
  (t (e/fcvtzs true true (u 0) (u 1)) "fcvtzs x0, d1")
  (t (e/fcvtzu false false (u 0) (u 1)) "fcvtzu w0, s1")
  (t (e/fmov-to-gp true (u 0) (u 1)) "fmov x0, d1")
  (t (e/fmov-to-gp false (u 0) (u 1)) "fmov w0, s1")
  (t (e/fmov-from-gp true (u 0) (u 1)) "fmov d0, x1")
  (t (e/fmov-from-gp false (u 0) (u 1)) "fmov s0, w1")
  (t (e/fmov-to-gp-hi (u 0) (u 1)) "fmov x0, v1.d[1]")
  (t (e/fmov-from-gp-hi (u 0) (u 1)) "fmov v0.d[1], x1")
  (t (e/mov-v (u 0) (u 1)) "mov v0.16b, v1.16b")
  (t (e/movi-zero (u 3)) "movi v3.2d, #0000000000000000")
  (t (e/fmov-imm true (u 0) (e/fp-imm8 (: 0x3FF0000000000000 u64) true)) "fmov d0, #1.00000000")
  (t (e/fmov-imm false (u 0) (e/fp-imm8 (: 0xC0000000 u64) false)) "fmov s0, #-2.00000000")
  (t (e/fmov-imm true (u 0) (e/fp-imm8 (: 0x3FE0000000000000 u64) true)) "fmov d0, #0.50000000")
  (t (e/ldaddal (u 3) (u 1) (u 0) (u 2)) "ldaddal x1, x0, [x2]")
  (t (e/swpal (u 2) (u 1) (u 0) (u 2)) "swpal w1, w0, [x2]")
  (t (e/casal (u 3) (u 1) (u 0) (u 2)) "casal x1, x0, [x2]")
  (t (e/ldar (u 3) (u 0) (u 2)) "ldar x0, [x2]")
  (t (e/stlr (u 0) (u 0) (u 2)) "stlrb w0, [x2]")
  ; mov-const sequences
  (let [(mut buf) [(: 0 u32) (: 0 u32) (: 0 u32) (: 0 u32)]
        p (cast (ptr u32) (mut buf))
        n1 (e/mov-const p (u 1) (: 0x12345678 u64))]
    (t (get buf 0) "mov w1, #22136")
    (t (get buf 1) "movk w1, #4660, lsl #16")
    (let [n2 (e/mov-const p (u 2) (: 0xFFFFFFFFFFFF1234 u64))]
      (t (get buf 0) "mov x2, #-60876")
      (let [n3 (e/mov-const p (u 3) (: 0x0000123400005678 u64))]
        (t (get buf 0) "mov x3, #22136")
        (t (get buf 1) "movk x3, #4660, lsl #32")
        0)))
  0)
