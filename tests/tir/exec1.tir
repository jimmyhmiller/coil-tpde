; sum of 1..n by a loop with PHIs
sum(%n, %one) {
entry:
  %zero = sub %n, %n
  br ^loop
loop:
  %i = phi [^entry, %n], [^body, %i2]
  %acc = phi [^entry, %zero], [^body, %acc2]
  condbr %i, ^body, ^done
body:
  %acc2 = add %acc, %i
  %i2 = sub %i, %one
  br ^loop
done:
  ret %acc
}

; calls and values live across calls
twice(%x) {
entry:
  %r = add %x, %x
  ret %r
}

callmany(%a, %b) {
entry:
  %c = call @twice, %a
  %d = call @twice, %b
  %e = add %c, %d
  %f = sub %e, %a
  ret %f
}

; register pressure: 40 live values
pressure(%a, %b) {
entry:
  %v1 = add %a, %b
  %v2 = add %v1, %a
  %v3 = add %v2, %b
  %v4 = add %v3, %v1
  %v5 = add %v4, %v2
  %v6 = add %v5, %v3
  %v7 = add %v6, %v4
  %v8 = add %v7, %v5
  %v9 = add %v8, %v6
  %v10 = add %v9, %v7
  %v11 = add %v10, %v8
  %v12 = add %v11, %v9
  %v13 = add %v12, %v10
  %v14 = add %v13, %v11
  %v15 = add %v14, %v12
  %v16 = add %v15, %v13
  %v17 = add %v16, %v14
  %v18 = add %v17, %v15
  %v19 = add %v18, %v16
  %v20 = add %v19, %v17
  %v21 = add %v20, %v18
  %v22 = add %v21, %v19
  %v23 = add %v22, %v20
  %v24 = add %v23, %v21
  %v25 = add %v24, %v22
  %v26 = add %v25, %v23
  %v27 = add %v26, %v24
  %v28 = add %v27, %v25
  %v29 = add %v28, %v26
  %v30 = add %v29, %v27
  %v31 = add %v30, %v28
  %v32 = add %v31, %v29
  %w1 = add %v1, %v32
  %w2 = add %w1, %v2
  %w3 = add %w2, %v3
  %w4 = add %w3, %v4
  %w5 = add %w4, %v5
  %w6 = add %w5, %v6
  %w7 = add %w6, %v7
  %w8 = add %w7, %v8
  %w9 = add %w8, %v9
  %w10 = add %w9, %v10
  %w11 = add %w10, %v11
  %w12 = add %w11, %v12
  %w13 = add %w12, %v13
  %w14 = add %w13, %v14
  %w15 = add %w14, %v15
  %w16 = add %w15, %v16
  %w17 = add %w16, %v17
  %w18 = add %w17, %v18
  %w19 = add %w18, %v19
  %w20 = add %w19, %v20
  %w21 = add %w20, %v21
  %w22 = add %w21, %v22
  %w23 = add %w22, %v23
  %w24 = add %w23, %v24
  %w25 = add %w24, %v25
  %w26 = add %w25, %v26
  %w27 = add %w26, %v27
  %w28 = add %w27, %v28
  %w29 = add %w28, %v29
  %w30 = add %w29, %v30
  %w31 = add %w30, %v31
  ret %w31
}

; swap cycle between PHIs
swapper(%a, %b, %n, %one) {
entry:
  %z = sub %n, %n
  br ^loop
loop:
  %x = phi [^entry, %a], [^body, %y]
  %y = phi [^entry, %b], [^body, %x]
  %i = phi [^entry, %n], [^body, %i2]
  condbr %i, ^body, ^done
body:
  %t = sub %i, %z
  %i2 = sub %t, %one
  br ^loop
done:
  %r = sub %x, %y
  ret %r
}

; many arguments: stack-passed
manyargs(%a, %b, %c, %d, %e, %f, %g, %h, %i, %j, %k) {
entry:
  %s1 = sub %a, %b
  %s2 = add %s1, %c
  %s3 = sub %s2, %d
  %s4 = add %s3, %e
  %s5 = sub %s4, %f
  %s6 = add %s5, %g
  %s7 = sub %s6, %h
  %s8 = add %s7, %i
  %s9 = sub %s8, %j
  %s10 = add %s9, %k
  ret %s10
}

callmanyargs(%x) {
entry:
  %r = call @manyargs, %x, %x, %x, %x, %x, %x, %x, %x, %x, %x, %x
  %s = call @manyargs, %r, %x, %r, %x, %r, %x, %r, %x, %r, %x, %r
  ret %s
}
