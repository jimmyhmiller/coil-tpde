;;; Encoder check: prints `<bytes> ; <expected llvm-mc text>` per instruction.
;;; `tpde-check enc` feeds the bytes to `llvm-mc --disassemble` (Intel syntax)
;;; and compares.
(module tpde.tests.enc-x64)
(import "tpde.x64.enc" :as e :use [mem mem-idx mem-rip])
(import "tpde.buf" :as buf :use [Buf])
(import "coil.primitive" :as primitive)

(defn r [(x i64)] (-> u8) (primitive/cast u8 x))

;; Encode with `f` into a fresh buffer and print it with the expected text.
(defn show [(b (ptr Buf)) (want (slice u8))] (-> void)
  (for k (range 0 (.len b))
    (when (> k 0) (print " "))
    (print "0x{:x}" (load (buf/buf-at b k))))
  (println " ; {}" want)
  (buf/buf-clear! b))

(defn main [] (-> i64)
  (let [(mut bb) (Buf::new)
        b (primitive/cast (ptr Buf) (mut bb))]
    ; moves
    (e/mov-rr! b true (r 0) (r 3)) (show b "mov rax, rbx")
    (e/mov-rr! b false (r 1) (r 2)) (show b "mov ecx, edx")
    (e/mov-rr! b true (r 8) (r 15)) (show b "mov r8, r15")
    (e/mov-rr! b true (r 12) (r 5)) (show b "mov r12, rbp")
    (e/mov-ri! b (r 0) 1) (show b "mov eax, 1")
    (e/mov-ri! b (r 9) 4294967295) (show b "mov r9d, 4294967295")
    (e/mov-ri! b (r 2) -1) (show b "mov rdx, -1")
    (e/mov-ri! b (r 3) 1234567890123) (show b "movabs rbx, 1234567890123")
    (e/load-m! b (r 0) (mem (r 3) 8) 8 false) (show b "mov rax, qword ptr [rbx + 8]")
    (e/load-m! b (r 0) (mem (r 5) -16) 8 false) (show b "mov rax, qword ptr [rbp - 16]")
    (e/load-m! b (r 1) (mem (r 4) 0) 8 false) (show b "mov rcx, qword ptr [rsp]")
    (e/load-m! b (r 1) (mem (r 12) 32) 8 false) (show b "mov rcx, qword ptr [r12 + 32]")
    (e/load-m! b (r 1) (mem (r 13) 0) 8 false) (show b "mov rcx, qword ptr [r13]")
    (e/load-m! b (r 10) (mem (r 5) -4096) 4 false) (show b "mov r10d, dword ptr [rbp - 4096]")
    (e/load-m! b (r 0) (mem (r 7) 0) 4 true) (show b "movsxd rax, dword ptr [rdi]")
    (e/load-m! b (r 0) (mem (r 7) 2) 2 false) (show b "movzx eax, word ptr [rdi + 2]")
    (e/load-m! b (r 0) (mem (r 7) 2) 2 true) (show b "movsx rax, word ptr [rdi + 2]")
    (e/load-m! b (r 6) (mem (r 7) 1) 1 false) (show b "movzx esi, byte ptr [rdi + 1]")
    (e/load-m! b (r 6) (mem (r 7) 1) 1 true) (show b "movsx rsi, byte ptr [rdi + 1]")
    (e/load-m! b (r 0) (mem-idx (r 3) (r 1) (r 8) 4) 8 false) (show b "mov rax, qword ptr [rbx + 8*rcx + 4]")
    (e/load-m! b (r 0) (mem-idx (r 13) (r 9) (r 2) 0) 8 false) (show b "mov rax, qword ptr [r13 + 2*r9]")
    (e/load-m! b (r 0) (mem-rip 0) 8 false) (show b "mov rax, qword ptr [rip]")
    (e/store-m! b (mem (r 5) -8) (r 0) 8) (show b "mov qword ptr [rbp - 8], rax")
    (e/store-m! b (mem (r 5) -8) (r 9) 4) (show b "mov dword ptr [rbp - 8], r9d")
    (e/store-m! b (mem (r 3) 0) (r 1) 2) (show b "mov word ptr [rbx], cx")
    (e/store-m! b (mem (r 3) 0) (r 6) 1) (show b "mov byte ptr [rbx], sil")
    (e/store-m! b (mem (r 3) 0) (r 0) 1) (show b "mov byte ptr [rbx], al")
    (e/store-mi! b (mem (r 4) 8) -2 8) (show b "mov qword ptr [rsp + 8], -2")
    (e/store-mi! b (mem (r 4) 8) 7 1) (show b "mov byte ptr [rsp + 8], 7")
    (e/lea! b (r 0) (mem (r 5) -16)) (show b "lea rax, [rbp - 16]")
    (e/lea! b (r 0) (mem-rip 16)) (show b "lea rax, [rip + 16]")
    (e/movzx! b (r 0) (r 7) 1) (show b "movzx eax, dil")
    (e/movzx! b (r 0) (r 1) 2) (show b "movzx eax, cx")
    (e/movsx! b (r 0) (r 1) 1) (show b "movsx rax, cl")
    (e/movsx! b (r 0) (r 1) 2) (show b "movsx rax, cx")
    (e/movsx! b (r 0) (r 1) 4) (show b "movsxd rax, ecx")
    (e/xchg! b true (r 0) (r 1)) (show b "xchg rax, rcx")
    ; arithmetic
    (e/alu-rr! b e/ALU-ADD true (r 0) (r 1)) (show b "add rax, rcx")
    (e/alu-rr! b e/ALU-SUB false (r 8) (r 9)) (show b "sub r8d, r9d")
    (e/alu-rr! b e/ALU-XOR false (r 0) (r 0)) (show b "xor eax, eax")
    (e/alu-rr! b e/ALU-CMP true (r 3) (r 12)) (show b "cmp rbx, r12")
    (e/alu-rr! b e/ALU-AND true (r 0) (r 1)) (show b "and rax, rcx")
    (e/alu-rr! b e/ALU-OR true (r 0) (r 1)) (show b "or rax, rcx")
    (e/alu-rr! b e/ALU-ADC true (r 0) (r 1)) (show b "adc rax, rcx")
    (e/alu-rr! b e/ALU-SBB true (r 0) (r 1)) (show b "sbb rax, rcx")
    (e/alu-ri! b e/ALU-ADD true (r 4) 16) (show b "add rsp, 16")
    (e/alu-ri! b e/ALU-SUB true (r 4) 4096) (show b "sub rsp, 4096")
    (e/alu-ri! b e/ALU-CMP false (r 7) -1) (show b "cmp edi, -1")
    (e/alu-rm! b e/ALU-ADD true (r 0) (mem (r 3) 8)) (show b "add rax, qword ptr [rbx + 8]")
    (e/alu-mi! b e/ALU-CMP (mem (r 3) 8) 5 8) (show b "cmp qword ptr [rbx + 8], 5")
    (e/test-rr! b true (r 0) (r 0)) (show b "test rax, rax")
    (e/test-ri! b false (r 1) 256) (show b "test ecx, 256")
    (e/test8-ri! b (r 6) 1) (show b "test sil, 1")
    (e/imul-rr! b true (r 0) (r 1)) (show b "imul rax, rcx")
    (e/imul-rri! b true (r 0) (r 1) 10) (show b "imul rax, rcx, 10")
    (e/imul-rri! b false (r 0) (r 1) 1000) (show b "imul eax, ecx, 1000")
    (e/g3! b e/G3-NEG true (r 0)) (show b "neg rax")
    (e/g3! b e/G3-NOT false (r 9)) (show b "not r9d")
    (e/g3! b e/G3-MUL true (r 1)) (show b "mul rcx")
    (e/g3! b e/G3-IMUL true (r 1)) (show b "imul rcx")
    (e/g3! b e/G3-DIV true (r 1)) (show b "div rcx")
    (e/g3! b e/G3-IDIV false (r 1)) (show b "idiv ecx")
    (e/cqo! b true) (show b "cqo")
    (e/cqo! b false) (show b "cdq")
    (e/shift-cl! b e/SH-SHL true (r 0)) (show b "shl rax, cl")
    (e/shift-cl! b e/SH-SAR false (r 2)) (show b "sar edx, cl")
    (e/shift-ri! b e/SH-SHR true (r 0) 3) (show b "shr rax, 3")
    (e/shift-ri! b e/SH-ROL true (r 0) 7) (show b "rol rax, 7")
    (e/shift-ri! b e/SH-ROR false (r 0) 7) (show b "ror eax, 7")
    (e/shld-ri! b (r 2) (r 0) 5) (show b "shld rdx, rax, 5")
    (e/shrd-cl! b (r 0) (r 2)) (show b "shrd rax, rdx, cl")
    (e/setcc! b e/CC-E (r 0)) (show b "sete al")
    (e/setcc! b e/CC-L (r 7)) (show b "setl dil")
    (e/setcc! b e/CC-A (r 10)) (show b "seta r10b")
    (e/cmovcc! b e/CC-NE true (r 0) (r 1)) (show b "cmovne rax, rcx")
    (e/cmovcc! b e/CC-GE false (r 8) (r 1)) (show b "cmovge r8d, ecx")
    (e/bswap! b true (r 0)) (show b "bswap rax")
    (e/bswap! b false (r 9)) (show b "bswap r9d")
    (e/lzcnt! b true (r 0) (r 1)) (show b "lzcnt rax, rcx")
    (e/tzcnt! b false (r 0) (r 1)) (show b "tzcnt eax, ecx")
    (e/popcnt! b true (r 0) (r 9)) (show b "popcnt rax, r9")
    (e/bsr! b true (r 0) (r 1)) (show b "bsr rax, rcx")
    (e/bt-ri! b true (r 0) 40) (show b "bt rax, 40")
    ; atomics
    (e/lock-cmpxchg! b (mem (r 7) 0) (r 1) 8) (show b "lock cmpxchg qword ptr [rdi], rcx")
    (e/lock-cmpxchg! b (mem (r 7) 0) (r 6) 1) (show b "lock cmpxchg byte ptr [rdi], sil")
    (e/lock-xadd! b (mem (r 7) 0) (r 1) 4) (show b "lock xadd dword ptr [rdi], ecx")
    (e/xchg-m! b (mem (r 7) 0) (r 1) 8) (show b "xchg qword ptr [rdi], rcx")
    (e/mfence! b) (show b "mfence")
    ; control flow
    (e/jcc32! b e/CC-NE 16) (show b "jne 16")
    (e/jcc8! b e/CC-E -2) (show b "je -2")
    (e/jmp32! b 0) (show b "jmp 0")
    (e/jmp8! b 5) (show b "jmp 5")
    (e/jmp-r! b (r 11)) (show b "jmp r11")
    (e/jmp-m! b (mem-idx (r 0) (r 1) (r 8) 0)) (show b "jmp qword ptr [rax + 8*rcx]")
    (e/call32! b 0) (show b "call 0")
    (e/call-r! b (r 0)) (show b "call rax")
    (e/call-r! b (r 11)) (show b "call r11")
    (e/ret! b) (show b "ret")
    (e/push! b (r 5)) (show b "push rbp")
    (e/push! b (r 12)) (show b "push r12")
    (e/pop! b (r 15)) (show b "pop r15")
    (e/ud2! b) (show b "ud2")
    (e/int3! b) (show b "int3")
    ; SSE
    (e/sse-load! b (r 32) (mem (r 5) -8) 8) (show b "movsd xmm0, qword ptr [rbp - 8]")
    (e/sse-load! b (r 41) (mem (r 5) -8) 4) (show b "movss xmm9, dword ptr [rbp - 8]")
    (e/sse-load! b (r 1) (mem (r 7) 0) 16) (show b "movups xmm1, xmmword ptr [rdi]")
    (e/sse-store! b (mem (r 5) -8) (r 2) 8) (show b "movsd qword ptr [rbp - 8], xmm2")
    (e/sse-store! b (mem (r 4) 0) (r 15) 4) (show b "movss dword ptr [rsp], xmm15")
    (e/sse-store! b (mem (r 4) 16) (r 3) 16) (show b "movups xmmword ptr [rsp + 16], xmm3")
    (e/movaps! b (r 0) (r 9)) (show b "movaps xmm0, xmm9")
    (e/movq-xg! b true (r 0) (r 1)) (show b "movq xmm0, rcx")
    (e/movq-xg! b false (r 0) (r 1)) (show b "movd xmm0, ecx")
    (e/movq-gx! b true (r 0) (r 1)) (show b "movq rax, xmm1")
    (e/movq-gx! b false (r 9) (r 1)) (show b "movd r9d, xmm1")
    (e/sse-arith! b e/SSE-ADD true (r 0) (r 1)) (show b "addsd xmm0, xmm1")
    (e/sse-arith! b e/SSE-SUB false (r 0) (r 1)) (show b "subss xmm0, xmm1")
    (e/sse-arith! b e/SSE-MUL true (r 8) (r 1)) (show b "mulsd xmm8, xmm1")
    (e/sse-arith! b e/SSE-DIV false (r 0) (r 12)) (show b "divss xmm0, xmm12")
    (e/sse-arith! b e/SSE-SQRT true (r 0) (r 1)) (show b "sqrtsd xmm0, xmm1")
    (e/sse-arith! b e/SSE-MIN true (r 0) (r 1)) (show b "minsd xmm0, xmm1")
    (e/sse-arith! b e/SSE-MAX false (r 0) (r 1)) (show b "maxss xmm0, xmm1")
    (e/sse-logic! b e/SSE-XOR false (r 0) (r 0)) (show b "xorps xmm0, xmm0")
    (e/sse-logic! b e/SSE-AND true (r 0) (r 1)) (show b "andpd xmm0, xmm1")
    (e/sse-logic! b e/SSE-ANDN false (r 0) (r 1)) (show b "andnps xmm0, xmm1")
    (e/sse-logic! b e/SSE-OR true (r 0) (r 1)) (show b "orpd xmm0, xmm1")
    (e/ucomis! b true (r 0) (r 1)) (show b "ucomisd xmm0, xmm1")
    (e/ucomis! b false (r 10) (r 1)) (show b "ucomiss xmm10, xmm1")
    (e/cvtsi2s! b true true (r 0) (r 1)) (show b "cvtsi2sd xmm0, rcx")
    (e/cvtsi2s! b false false (r 0) (r 1)) (show b "cvtsi2ss xmm0, ecx")
    (e/cvtts2si! b true true (r 0) (r 1)) (show b "cvttsd2si rax, xmm1")
    (e/cvtts2si! b false false (r 0) (r 9)) (show b "cvttss2si eax, xmm9")
    (e/cvt-ss-sd! b true (r 0) (r 1)) (show b "cvtss2sd xmm0, xmm1")
    (e/cvt-ss-sd! b false (r 0) (r 1)) (show b "cvtsd2ss xmm0, xmm1")
    (e/rounds! b true (r 0) (r 1) 3) (show b "roundsd xmm0, xmm1, 3")
    (e/rounds! b false (r 0) (r 1) 1) (show b "roundss xmm0, xmm1, 1")
    0))
